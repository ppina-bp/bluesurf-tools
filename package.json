{
  "name": "@bluepeople/bluesurf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Blue Surf CLI and agent skills. Uses your SSO session only.",
  "bin": {
    "bluesurf": "./bin/bluesurf.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "rules",
    "templates",
    "package.json"
  ],
  "scripts": {
    "setup": "node bin/bluesurf.mjs setup",
    "link-skills": "node scripts/link-skills.mjs",
    "login": "node bin/bluesurf.mjs login",
    "spike": "node scripts/spike-capture.mjs",
    "ticket": "node bin/bluesurf.mjs ticket",
    "ticket-done": "node bin/bluesurf.mjs ticket-done",
    "sprint": "node bin/bluesurf.mjs sprint",
    "sprint-review": "node bin/bluesurf.mjs sprint-review",
    "move": "node bin/bluesurf.mjs move",
    "mine": "node bin/bluesurf.mjs mine",
    "daily-report": "node bin/bluesurf.mjs daily-report",
    "test": "node --test test/*.test.js",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "playwright": "^1.55.0",
    "smol-toml": "^1.3.1"
  }
}
