# Legacy dev-clone overrides. End users: use ~/.config/bluesurf/config.toml (bluesurf setup).
# No secrets. Session: ~/.local/share/bluesurf/session/ (bluesurf login).

BLUESURF_ORIGIN=https://surf.bluepeople.com
BLUESURF_PROJECT=RLD

# Workstore (path kind) — prefer [workstore] in config.toml
OBSIDIAN_VAULT=/path/to/your/workstore/root
OBSIDIAN_TICKETS_DIR=Tickets
OBSIDIAN_SPRINTS_DIR=Sprints